{
  // the prototype's TypeScript, type-checked by stock tsc (vp run typecheck):
  // its scripts, programs and tests. Node runs it as it is, its types
  // stripped. tsconfig.programs.json is what the tsgo fork compiles
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    // the playground's runtime, which the programs here run on: its API, and
    // its modules, which the hand-written programs import (expand.ts points
    // them at the runtime's directory)
    "paths": {
      "threads": ["./playground/runtime/threads.d.ts"],
      "threads/own": ["./playground/runtime/own.ts"],
      "threads/runtime": ["./playground/runtime/runtime.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
