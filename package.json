{
  "name": "@arv/structs",
  "version": "0.0.0",
  "private": true,
  "description": "The TC39 structs proposal (structs, shared structs, Mutex and Condition) for JavaScript today: a runtime and a compiler for its syntax",
  "homepage": "https://github.com/arv/threads/tree/tc39-proposal#readme",
  "bugs": {
    "url": "https://github.com/arv/threads/issues"
  },
  "license": "Apache-2.0",
  "author": "Erik Arvidsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arv/threads.git"
  },
  "bin": {
    "structs": "./src/compiler/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime/api.d.ts",
      "default": "./src/runtime/index.ts"
    },
    "./runtime": "./src/runtime/emit.ts",
    "./agent": {
      "types": "./src/runtime/agent-api.d.ts",
      "default": "./src/runtime/agent.ts"
    },
    "./compiler": "./src/compiler/index.ts",
    "./register": "./src/register.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "magic-string": "^1.4.3",
    "oxc-transform": "^0.153.0",
    "typescript": "7.1.0-dev.20261011.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.11.2"
}
