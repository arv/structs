{
  "name": "@arv/structs",
  "version": "0.1.0",
  "description": "The TC39 structs proposal for JavaScript today: structs, shared structs, SharedArray, Atomics.Mutex and Atomics.Condition, on Web Workers and worker_threads that share memory",
  "keywords": [
    "Atomics",
    "SharedArrayBuffer",
    "shared structs",
    "structs",
    "tc39",
    "threads",
    "workers"
  ],
  "homepage": "https://github.com/arv/structs#readme",
  "bugs": {
    "url": "https://github.com/arv/structs/issues"
  },
  "license": "Apache-2.0",
  "author": "Erik Arvidsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arv/structs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime/api.d.ts",
      "default": "./src/runtime/index.ts"
    },
    "./runtime": "./src/runtime/emit.ts",
    "./agent": {
      "types": "./src/runtime/agent-api.d.ts",
      "default": "./src/runtime/agent.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/api.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/emit.d.ts",
        "default": "./dist/emit.js"
      },
      "./agent": {
        "types": "./dist/agent-api.d.ts",
        "default": "./dist/agent.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build-dist": "node build-dist.ts",
    "prepack": "node build-dist.ts",
    "test-pack": "node test-pack.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "7.1.0-dev.20261011.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.11.2"
}
