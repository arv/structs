{
  // the programs in plain TypeScript on threads (they import its API,
  // src/runtime/threads.d.ts, as @arv/threads): threads-check checks their
  // ownership and compiles them to build/ts/*.js for the runtime (run them with
  // src/run.ts or src/chrome.ts):
  //   vp run build-programs
  // which is
  //   node src/checker/cli.ts compile -p tsconfig.programs.json \
  //     --runtime @arv/threads
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "build/ts",
    "paths": {"@arv/threads": ["./src/runtime/threads.d.ts"]}
  },
  "files": [
    "src/nbody-ts.ts",
    "src/nbody-struct.ts",
    "src/tutorial.ts",
    "src/refcount.ts",
    "src/mandelbrot-chan.ts",
    "src/pipeline.ts",
    "src/nbody-chan.ts",
    "src/nbody-chan-struct.ts"
  ]
}
