{#- The sidebar's sections, open, each a list of pages; the current page is
    marked. The desktop sidebar and the phone's menu both show it -#}
<div class="docs-menu">
  {%- for section in sections %}
  <details class="menu-section" open>
    <summary>
      <h4>{{ section.title }}</h4>
      <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </summary>
    <ul>
      {%- for item in section.items %}
      <li>
        <a href="{{ item.url }}"
          {%- if item.url == page.url %} class="active" aria-current="page"{% endif %}>
          {{- item.title -}}
          {%- if item.app %}<svg class="external" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10M7 17 17 7" /></svg>{% endif -%}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </details>
  {%- endfor %}

  <div class="footer-container">
    <p class="copyright">
      Made by <a href="{{ repository }}" class="footer-text-link">Erik Arvidsson</a>
    </p>
    <div class="social-links">
      <a href="{{ repository }}/tree/{{ branch }}" aria-label="arv/structs on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="none" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
    </div>
    <div class="theme-toggle-group" role="group" aria-label="Theme">
      <button type="button" class="theme-toggle" data-theme-choice="light" title="Light theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        <span class="sr-only">Light theme</span>
      </button>
      <button type="button" class="theme-toggle" data-theme-choice="dark" title="Dark theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        <span class="sr-only">Dark theme</span>
      </button>
      <button type="button" class="theme-toggle" data-theme-choice="system" title="System theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
        <span class="sr-only">System theme</span>
      </button>
    </div>
  </div>
</div>
