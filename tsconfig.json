{
  // src/ (but the checker, which has its own) and the playground's Vite
  // config, type-checked by stock tsc (vp run typecheck): the runtime, the
  // prototype's scripts and programs, and the tests. Node runs them as they
  // are, their types stripped. The playground's page has its own
  // (playground/tsconfig.json), and tsconfig.programs.json is what the tsgo
  // fork compiles
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    // the runtime's API, and its modules, which the hand-written programs
    // import (expand.ts points them at the runtime's directory)
    "paths": {
      "@arv/threads": ["./src/runtime/threads.d.ts"],
      "@arv/threads/own": ["./src/runtime/own.ts"],
      "@arv/threads/runtime": ["./src/runtime/runtime.ts"]
    }
  },
  "include": ["src/**/*.ts", "playground/vite.config.ts"],
  "exclude": ["src/checker"],
  // a glob leaves out a .d.ts beside a .ts of its name: a page's API is checked
  // as well, by name
  "files": ["src/runtime/browser.d.ts", "src/runtime/heap.d.ts"]
}
