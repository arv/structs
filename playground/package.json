{
  "name": "threads-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Threads for JavaScript in plain TypeScript: own and shared values, shared structs and channels on Web Workers, with a playground that shows the compiled JavaScript.",
  "license": "Apache-2.0",
  "author": "Erik Arvidsson",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "build-wasm": "node build-wasm.ts",
    "test-build": "node test-build.ts",
    "typecheck": "tsc --noEmit",
    "own-check": "node ../src/checker/cli.ts -p tsconfig.json --runtime @arv/threads"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@arv/threads-check": "workspace:*",
    "@oxc-transform/binding-wasm32-wasip1": "0.153.0",
    "@types/node": "catalog:",
    "buffer": "^6.0.3",
    "pathe": "^2.0.3",
    "playwright-core": "^1.64.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
