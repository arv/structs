{
  // programs in plain TypeScript on threads.mjs: stock tsc type-checks them, and the tsgo fork checks
  // ownership and emits build/ts/*.mjs for the runtime (run them with run.mjs or chrome.mjs):
  //   <fork>/built/local/tsgo own check -p threads/escape-proto/tsconfig.json --ownRuntime ./threads.mjs
  //   <fork>/built/local/tsgo -p threads/escape-proto/tsconfig.json --ownRuntime ./threads.mjs
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "outDir": "build/ts"
  },
  "files": ["nbody-ts.mts", "nbody-struct.mts", "tutorial.mts", "refcount.mts", "mandelbrot-chan.mts", "pipeline.mts", "nbody-chan.mts", "nbody-chan-struct.mts"]
}
