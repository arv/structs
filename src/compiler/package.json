{
  "name": "@arv/structs-compiler",
  "version": "0.1.0",
  "description": "The compiler of @arv/structs: the TC39 structs proposal's syntax (struct, shared struct) compiled to JavaScript, a command line, and a Node load hook; TypeScript projects type checked, with shared struct field access made direct",
  "keywords": [
    "compiler",
    "shared structs",
    "structs",
    "tc39",
    "typescript"
  ],
  "homepage": "https://github.com/arv/structs#readme",
  "bugs": {
    "url": "https://github.com/arv/structs/issues"
  },
  "license": "Apache-2.0",
  "author": "Erik Arvidsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arv/structs.git",
    "directory": "src/compiler"
  },
  "bin": {
    "structs": "./cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./register": "./register.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "structs": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build-dist": "node build-dist.ts",
    "prepack": "node build-dist.ts"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "magic-string": "^1.4.3",
    "oxc-transform": "^0.153.0",
    "typescript": "7.1.0-dev.20261011.1"
  },
  "devDependencies": {
    "@arv/structs": "workspace:^",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "@arv/structs": "workspace:^"
  },
  "engines": {
    "node": ">=22.13"
  }
}
