{
  // the runtime, the compiler and the tests, type-checked by stock tsc (vp run
  // typecheck). Node runs them as they are, their types stripped. Programs in
  // the proposal's syntax (examples/, test/fixtures/) are the compiler's to
  // check: tsc cannot parse them
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024", "esnext.disposable", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "exclude": ["test/fixtures"]
}
