{
  // programs in plain TypeScript on threads.js: stock tsc type-checks them, and
  // the tsgo fork checks ownership and emits build/ts/*.js for the runtime (run
  // them with src/run.js or src/chrome.js):
  //   <fork>/built/local/tsgo own check -p tsconfig.json \
  //     --ownRuntime ./threads.js
  //   <fork>/built/local/tsgo -p tsconfig.json --ownRuntime ./threads.js
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "build/ts"
  },
  "files": [
    "src/nbody-ts.ts",
    "src/nbody-struct.ts",
    "src/tutorial.ts",
    "src/refcount.ts",
    "src/mandelbrot-chan.ts",
    "src/pipeline.ts",
    "src/nbody-chan.ts",
    "src/nbody-chan-struct.ts"
  ]
}
