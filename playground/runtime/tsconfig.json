{
  // the runtime and the Vite plugin, type-checked by stock tsc (vp run
  // typecheck). Programs see the runtime only through its API, threads.d.ts
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    // the API, as programs and browser.d.ts import it
    "paths": {"threads": ["./threads.d.ts"]}
  },
  "include": ["*.ts", "../vite.config.ts", "../assets.d.ts"],
  // a glob leaves out a .d.ts beside a .ts of its name: the page's API
  // (browser.d.ts) is checked as well, by name
  "files": ["browser.d.ts"]
}
