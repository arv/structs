{
  // programs in plain TypeScript on threads.js: stock tsc type-checks them, and
  // the tsgo fork checks ownership and emits build/ts/*.js for the runtime (run
  // them with run.js or chrome.js):
  //   <fork>/built/local/tsgo own check -p tsconfig.json \
  //     --ownRuntime ./threads.js
  //   <fork>/built/local/tsgo -p tsconfig.json --ownRuntime ./threads.js
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "outDir": "build/ts"
  },
  "files": [
    "nbody-ts.ts",
    "nbody-struct.ts",
    "tutorial.ts",
    "refcount.ts",
    "mandelbrot-chan.ts",
    "pipeline.ts",
    "nbody-chan.ts",
    "nbody-chan-struct.ts"
  ]
}
