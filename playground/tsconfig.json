{
  // plain TypeScript: tsc checks the types (vp run typecheck), threads-check
  // the ownership (vp run own-check), and the Vite plugin compiles with the
  // fork. programs/mistakes.ts is left out on purpose: it is the playground's
  // example of what the ownership checker catches
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@arv/threads": ["../src/runtime/threads.d.ts"],
      "@arv/threads/heap": ["../src/runtime/heap.d.ts"],
      "@arv/threads/browser": ["../src/runtime/browser.d.ts"],
      "@arv/threads/compiled": ["../src/runtime/compiled.d.ts"]
    }
  },
  "include": ["*.ts", "tsgo/*.ts", "programs/*.ts"],
  // the Vite config, build-wasm.ts, test-build.ts and the tests of tsgo/ run
  // on node, and the compiler's worker runs threads-check, which is written
  // for node: ../tsconfig.json checks them
  "exclude": [
    "programs/mistakes.ts",
    "vite.config.ts",
    "build-wasm.ts",
    "test-build.ts",
    "tsgo/*.test.ts",
    "compiler.ts",
    "compiler.test.ts"
  ]
}
