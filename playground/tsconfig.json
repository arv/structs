{
  // plain TypeScript: tsc checks the types (vp run typecheck), threads-check
  // the ownership (vp run own-check), and the Vite plugin compiles with the
  // fork. programs/mistakes.ts is left out on purpose: it is the playground's
  // example of what the ownership checker catches
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "paths": {
      "threads": ["../src/runtime/threads.d.ts"],
      "threads/heap": ["../src/runtime/heap.d.ts"],
      "threads/browser": ["../src/runtime/browser.d.ts"]
    }
  },
  "include": ["*.ts", "programs/*.ts"],
  // the Vite config runs on node, with the runtime: ../tsconfig.json checks it
  "exclude": ["programs/mistakes.ts", "vite.config.ts"]
}
